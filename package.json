{
  "name": "gitflow-story",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "homepage": "https://neocra.github.io/git-flows-story",
  "dependencies": {
    "@gitgraph/core": "^1.5.0",
    "@gitgraph/react": "^1.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-vitals": "^6.1.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-links": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "storybook": "^10.5.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "cleanup": "rm -rf node_modules/.cache/gh-pages/",
    "predeploy": "yarn build-storybook",
    "deploy": "yarn cleanup && gh-pages -b deploy -d storybook-static"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
